{
  "name": "@nagis/api",
  "version": "0.1.0",
  "private": true,
  "description": "NAG'IS REST API (NestJS + Prisma + PostgreSQL)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node scripts/with-env.mjs node dist/main.js",
    "start:dev": "node scripts/with-env.mjs nest start --watch",
    "start:debug": "node scripts/with-env.mjs nest start --debug --watch",
    "start:prod": "node scripts/with-env.mjs node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile .tsbuildinfo.typecheck",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest --config jest.config.js --passWithNoTests",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "db:generate": "node scripts/with-env.mjs prisma generate",
    "db:generate:ci": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:migrate:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:reset": "node scripts/with-env.mjs prisma migrate reset --force",
    "db:seed": "node scripts/with-env.mjs prisma db seed",
    "admin:create": "node scripts/with-env.mjs node --import tsx scripts/create-admin.ts",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "db:push": "node scripts/with-env.mjs prisma db push",
    "prebuild": "node scripts/clean.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nagis/shared-types": "*",
    "@nagis/shared-validation": "*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "^3.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
