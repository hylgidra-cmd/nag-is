save-exact=false
fund=false
audit=false

# This project lives in a OneDrive-synced folder on at least one developer
# machine, and the registry connection here is slow enough that large
# tarballs (prisma, webpack, next) were resetting mid-download. Generous
# timeouts plus more retries make `npm install` survive that; see
# docs/development.md for the node_modules junction that keeps dependencies
# out of OneDrive entirely.
fetch-retries=10
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=600000
fetch-timeout=900000
maxsockets=8
