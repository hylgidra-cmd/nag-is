# ============================================================================
# NAG'IS — ortaliq ozgeriwshileri (environment variables)
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# docker compose up -d postgres  ->  maps container 5432 to host 5433
DATABASE_URL="postgresql://nagis:nagis_dev_password@localhost:5433/nagis?schema=public"
# Max node-postgres pool connections. Keep below the server's
# max_connections divided by the number of API instances.
DATABASE_POOL_MAX="10"

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
NODE_ENV="development"
API_PORT="3001"
API_GLOBAL_PREFIX="api"
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-48-random-bytes-base64url"
JWT_REFRESH_SECRET="replace-with-a-different-48-random-bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Cookie domain is left empty in development so the host is used as-is.
AUTH_COOKIE_DOMAIN=""
# Set to "true" only when serving over HTTPS.
AUTH_COOKIE_SECURE="false"

# Bcrypt work factor. 12 is a sane production default.
PASSWORD_HASH_ROUNDS="12"

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="120"
THROTTLE_AUTH_LIMIT="10"

# ---------------------------------------------------------------------------
# File / image storage abstraction
# driver: "local" | "s3"
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
STORAGE_PUBLIC_BASE_URL="http://localhost:3001/api/v1/files"
# Only required when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Video hosting abstraction
# driver: "none" | "mux" | "vimeo" | "bunny"
# While "none", lessons fall back to their stored public URL and signed
# playback is disabled. See docs/development.md.
# ---------------------------------------------------------------------------
VIDEO_DRIVER="none"
VIDEO_SIGNING_KEY=""
VIDEO_SIGNING_KEY_ID=""
VIDEO_PLAYBACK_TTL_SECONDS="7200"

# ---------------------------------------------------------------------------
# Payments
# driver: "dev" | "payme" | "click"
# "dev" is a DEVELOPMENT-ONLY adapter. It refuses to load when
# NODE_ENV=production. Real providers must be configured before launch.
# ---------------------------------------------------------------------------
# none  = checkout unavailable (no order-creation endpoint exists yet) -- the
#         only value that can be deployed to production truthfully
# dev   = development-only, fabricates payments; rejected when NODE_ENV=production
# payme / click = real providers, require their credentials below
PAYMENT_DRIVER="dev"
PAYMENT_CURRENCY="UZS"
# Payme (https://developer.help.paycom.uz) — fill in when the merchant
# account exists.
PAYME_MERCHANT_ID=""
PAYME_MERCHANT_KEY=""
PAYME_CHECKOUT_URL="https://checkout.paycom.uz"
# Click (https://docs.click.uz)
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Email (password reset). driver: "console" | "smtp"
# "console" writes the reset link to the server log instead of sending mail.
# ---------------------------------------------------------------------------
MAIL_DRIVER="console"
MAIL_FROM="NAG'IS <no-reply@nagis.uz>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Logging
# level: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
LOG_PRETTY="true"

# ---------------------------------------------------------------------------
# Seed data (development only)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@nagis.uz"
SEED_ADMIN_PASSWORD="Admin12345!"
SEED_STUDENT_EMAIL="student@nagis.uz"
SEED_STUDENT_PASSWORD="Student12345!"

# ---------------------------------------------------------------------------
# Web app (Next.js)
# ---------------------------------------------------------------------------
# Server-side base URL the Next.js server uses to reach the API directly.
API_INTERNAL_URL="http://localhost:3001"
# Public site URL, used for canonical links and certificate verify URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="kaa"

# ---------------------------------------------------------------------------
# Vercel deployment (production / preview)
# ---------------------------------------------------------------------------
# These are NOT read from this file in a deployment — set them in the Vercel
# project's Environment Variables. They are listed here so the required set is
# documented in one place. Every value below is a placeholder.
#
# Scope each variable to the service that needs it:
#
#   api service   DATABASE_URL, DIRECT_DATABASE_URL, DATABASE_POOL_MAX,
#                 JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, AUTH_COOKIE_SECURE,
#                 CORS_ORIGINS, NODE_ENV, plus any payment/mail/storage keys
#   web service   NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_DEFAULT_LOCALE
#
# API_INTERNAL_URL is deliberately absent from the deployed web service: it is
# injected at runtime by the `api` service binding declared in vercel.json.
# Setting it by hand would override the binding and send internal traffic back
# out through the public edge.

# Pooled connection string, used by the running API. A serverless deployment
# opens connections from many short-lived instances, so this must point at a
# connection pooler, not directly at PostgreSQL.
# DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DBNAME?sslmode=require"

# Direct (unpooled) connection string. Schema migrations must not run through a
# transaction-mode pooler, so `prisma migrate deploy` uses this one.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require"

# Per-instance connection cap. The real ceiling is instances x this value, so
# keep it small on serverless. Defaults to 3 when VERCEL is set.
# DATABASE_POOL_MAX="3"

# Generate fresh secrets for production; never reuse the development values.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET="GENERATE_A_UNIQUE_VALUE"
# JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_UNIQUE_VALUE"

# Must be true in production — the env schema rejects a production boot
# without it, so session cookies are never sent over plain HTTP.
# AUTH_COOKIE_SECURE="true"

# Browser requests reach the API same-origin through the platform rewrite, so
# CORS is not involved. Set this only for direct API clients on other origins.
# CORS_ORIGINS="https://your-domain.example"

# Public origin of the deployment, used for canonical links and the
# certificate verification URL printed on certificates.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"
