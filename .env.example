# ============================================================================
# NAG'IS — ortaliq ozgeriwshileri (environment variables)
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# docker compose up -d postgres  ->  maps container 5432 to host 5433
DATABASE_URL="postgresql://nagis:nagis_dev_password@localhost:5433/nagis?schema=public"
# Max node-postgres pool connections. Keep below the server's
# max_connections divided by the number of API instances.
DATABASE_POOL_MAX="10"

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
NODE_ENV="development"
API_PORT="3001"
API_GLOBAL_PREFIX="api"
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-48-random-bytes-base64url"
JWT_REFRESH_SECRET="replace-with-a-different-48-random-bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Cookie domain is left empty in development so the host is used as-is.
AUTH_COOKIE_DOMAIN=""
# Set to "true" only when serving over HTTPS.
AUTH_COOKIE_SECURE="false"

# Bcrypt work factor. 12 is a sane production default.
PASSWORD_HASH_ROUNDS="12"

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="120"
THROTTLE_AUTH_LIMIT="10"

# ---------------------------------------------------------------------------
# File / image storage abstraction
# driver: "local" | "s3"
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
STORAGE_PUBLIC_BASE_URL="http://localhost:3001/api/v1/files"
# Only required when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Video hosting abstraction
# driver: "none" | "mux" | "vimeo" | "bunny"
# While "none", lessons fall back to their stored public URL and signed
# playback is disabled. See docs/development.md.
# ---------------------------------------------------------------------------
VIDEO_DRIVER="none"
VIDEO_SIGNING_KEY=""
VIDEO_SIGNING_KEY_ID=""
VIDEO_PLAYBACK_TTL_SECONDS="7200"

# ---------------------------------------------------------------------------
# Payments
# driver: "dev" | "payme" | "click"
# "dev" is a DEVELOPMENT-ONLY adapter. It refuses to load when
# NODE_ENV=production. Real providers must be configured before launch.
# ---------------------------------------------------------------------------
PAYMENT_DRIVER="dev"
PAYMENT_CURRENCY="UZS"
# Payme (https://developer.help.paycom.uz) — fill in when the merchant
# account exists.
PAYME_MERCHANT_ID=""
PAYME_MERCHANT_KEY=""
PAYME_CHECKOUT_URL="https://checkout.paycom.uz"
# Click (https://docs.click.uz)
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Email (password reset). driver: "console" | "smtp"
# "console" writes the reset link to the server log instead of sending mail.
# ---------------------------------------------------------------------------
MAIL_DRIVER="console"
MAIL_FROM="NAG'IS <no-reply@nagis.uz>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Logging
# level: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
LOG_PRETTY="true"

# ---------------------------------------------------------------------------
# Seed data (development only)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@nagis.uz"
SEED_ADMIN_PASSWORD="Admin12345!"
SEED_STUDENT_EMAIL="student@nagis.uz"
SEED_STUDENT_PASSWORD="Student12345!"

# ---------------------------------------------------------------------------
# Web app (Next.js)
# ---------------------------------------------------------------------------
# Server-side base URL the Next.js server uses to reach the API directly.
API_INTERNAL_URL="http://localhost:3001"
# Public site URL, used for canonical links and certificate verify URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="kaa"
